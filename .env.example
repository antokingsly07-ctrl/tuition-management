# Copy this file to ".env" for local dev (never commit .env)
# In Vercel: Project → Settings → Environment Variables → add MONGODB_URI
#
# Atlas: Cluster → Connect → Drivers → copy the string.
# Make sure it ends with a database name, e.g. /tuition
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/tuition
